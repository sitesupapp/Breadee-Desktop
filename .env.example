# ---------------------------------------------------------------------------
# Breadee Desktop — environment template. COPY this file, never commit real values.
#   Staging dev:  cp .env.example .env.desktop.staging   (then load it as .env)
#   Prod release: cp .env.example .env.desktop.production (ONLY after approval)
#
# SECURITY: anon (publishable) key ONLY. NEVER put the Supabase service_role key
# in a desktop build — it bypasses RLS. Staging builds must NEVER point at prod.
# ---------------------------------------------------------------------------

# Supabase project URL (staging vs production differ ONLY here + the anon key)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon / publishable key (safe to ship — RLS enforces access)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# App environment: "staging" | "production"
VITE_APP_ENV=staging

# Fixed for desktop builds
VITE_APP_PLATFORM=desktop
VITE_APP_NAME=Breadee
